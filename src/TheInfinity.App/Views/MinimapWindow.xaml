<Window x:Class="TheInfinity.App.Views.MinimapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TheInfinity.App.Controls"
        Title="The Infinity Minimap"
        Width="244" Height="196"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <!-- A separate top-level window: DWM thumbnails paint above all content of the overview window,
         so anything that must stay visible over them has to live in its own window. -->
    <StackPanel Margin="12">
        <controls:MinimapControl x:Name="Map" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Status}" Foreground="#93A0B5" FontSize="12" Margin="2,8,0,0"/>
    </StackPanel>
</Window>
