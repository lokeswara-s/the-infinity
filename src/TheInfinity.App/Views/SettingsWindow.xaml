<Window x:Class="TheInfinity.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Infinity settings"
        Icon="/Assets/app.ico"
        Width="620" Height="760" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        Foreground="{StaticResource Ink}"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <DockPanel TextElement.Foreground="{StaticResource Ink}">
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#0B0E14" Padding="24,14">
            <Grid>
                <TextBlock Text="Changes apply when you press Save." Style="{StaticResource Desc}" VerticalAlignment="Center" Margin="0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="88" IsCancel="True"/>
                    <Button Content="Save" MinWidth="88" IsDefault="True" Click="SaveClick" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Infinity places your real windows on a huge canvas. Nothing here needs administrator rights."
                           Style="{StaticResource Desc}" Margin="0,4,0,0"/>

                <TextBlock Text="NAVIGATION" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Draft.EnableGlobalPan}">
                            <StackPanel>
                                <TextBlock Text="Pan and zoom from any app"/>
                                <TextBlock Text="Ctrl+Alt + middle-drag pans, Ctrl+Alt + scroll zooms. Works even when another app has focus." Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Draft.SnapEnabled}">
                            <StackPanel>
                                <TextBlock Text="Snap while dragging"/>
                                <TextBlock Text="Windows line up with their neighbours when you move them in the overview." Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Farthest zoom-out" FontSize="13.5"/>
                                <TextBlock Text="0.15 means windows can shrink to 15% of their size. Real size (1.0) is always the closest." Style="{StaticResource Desc}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="72" Margin="20,0,0,0" VerticalAlignment="Center" TextAlignment="Center"
                                     Text="{Binding Draft.MinZoom, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="STARTUP" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Draft.StartWithWindows}">
                            <StackPanel>
                                <TextBlock Text="Start Infinity with Windows"/>
                                <TextBlock Text="Uses your own startup list. No service, no elevation." Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Draft.RestoreLayoutOnStartup}">
                            <StackPanel>
                                <TextBlock Text="Restore my layout"/>
                                <TextBlock Text="Put windows back where you left them when Infinity starts." Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Draft.LaunchMissingApps}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Launch apps that are not running"/>
                                <TextBlock Text="Off by default. Packaged and elevated apps can refuse to start, and Infinity never injects code into other apps."
                                           Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="WINDOWS" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Draft.ShowPlaceholders}">
                            <StackPanel>
                                <TextBlock Text="Remember windows of apps that are closed"/>
                                <TextBlock Text="Keeps a gold tile where they were so they snap back into place when the app returns." Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Draft.AutoSave}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Save automatically"/>
                                <TextBlock Text="Writes the workspace shortly after every change." Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="SAVED LAYOUTS" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="16">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save current layout" Command="{Binding Shell.SaveLayoutCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="14,0" Height="34"/>
                            <TextBox Text="{Binding Shell.LayoutName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="12,0" Tag="Name this layout"/>
                        </DockPanel>
                        <Grid Margin="0,12,0,0">
                            <ListBox ItemsSource="{Binding Shell.Layouts}" Height="132" MouseDoubleClick="LayoutActivated">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Created}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No saved layouts yet.&#x0A;Save one above, then double-click it here to restore."
                                       Foreground="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shell.Layouts.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="16,6">
                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#222B3F" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                                                        Padding="7,2" Margin="4,0,0,0" MinWidth="26">
                                                    <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Action}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
