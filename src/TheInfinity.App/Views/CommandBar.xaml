<UserControl x:Class="TheInfinity.App.Views.CommandBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="68">
    <!-- 8 px margin leaves room for the shadow inside the transparent window. -->
    <Border Margin="8" Background="#F2141A27" BorderBrush="#2A3347" BorderThickness="1" CornerRadius="14" Padding="14,0,8,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="32" Height="32" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Infinity" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="18,0,14,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Height="34" Padding="34,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search windows      Ctrl+Alt+S" KeyDown="SearchKeyDown"
                         ToolTip="Search by title or app. Enter zooms into the first match."/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                <Popup IsOpen="{Binding SearchOpen, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#F5171D2B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11"
                            Padding="4" Margin="0,6,14,16" MinWidth="320" MaxHeight="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent"
                                 MouseDoubleClick="ResultActivated" KeyDown="ResultKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProcessName}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Shows where you are: the real desktop (100%) or zoomed out. -->
                <Border CornerRadius="9" Padding="10,0" Height="30" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeLabel}" FontSize="12.5" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ZoomLabel}" Foreground="{StaticResource Ink}" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Command="{Binding ToggleOverviewCommand}" Padding="12,0" Height="34" Margin="0"
                        ToolTip="Zoom out to see every window, or go back (Ctrl+Alt+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OverviewButtonLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="LayoutsButton" Padding="12,0" Height="34" Margin="8,0,0,0" Click="LayoutsClick"
                        ToolTip="Save the current arrangement, or switch to a saved one">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Layouts" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="LayoutsPopup" PlacementTarget="{Binding ElementName=LayoutsButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" Closed="LayoutsClosed" HorizontalOffset="-250">
                    <Border Background="#F5171D2B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11"
                            Padding="14" Margin="14,6,14,16" Width="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="SAVE THIS ARRANGEMENT" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveLayoutCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="16,0" Height="34" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding LayoutName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="12,0"
                                         Tag="Name this layout" KeyDown="LayoutNameKeyDown"/>
                            </DockPanel>
                            <TextBlock Text="SAVED LAYOUTS" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                            <Grid>
                                <ListBox ItemsSource="{Binding Layouts}" MaxHeight="220" MinHeight="64" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <EventSetter Event="MouseLeftButtonUp" Handler="LayoutRowClick"/>
                                            <Setter Property="ToolTip" Value="Click to apply this layout"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                        Width="26" Height="26" FontSize="11" Click="LayoutDeleteClick" ToolTip="Delete this layout"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Created}" Foreground="{StaticResource Muted}"
                                                           FontSize="11.5" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No saved layouts yet.&#x0A;Name the current arrangement above and press Save."
                                           Foreground="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Layouts.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
                <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="10,0,8,0"/>

                <Button Style="{StaticResource IconButton}" Content="&#xE740;" Command="{Binding FitCommand}" ToolTip="Fit every window on screen (Ctrl+Alt+F)"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE80F;" Command="{Binding ResetCommand}" ToolTip="Back to the start (Ctrl+Alt+H)"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Command="{Binding SaveCommand}" ToolTip="Save the workspace now"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="Settings"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
