<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Per-user install: no administrator rights. Files land in %LocalAppData%\TheInfinity\app. -->
  <Package
      Name="The Infinity"
      Manufacturer="Lokeswara Sane"
      Version="1.0.0.0"
      UpgradeCode="8b6e2c41-7a4d-4f1e-9c3b-2d5a6e7f8091"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of The Infinity is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\TheInfinity.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="InstallRoot" Name="TheInfinity">
        <Directory Id="INSTALLFOLDER" Name="app" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="c4d91a27-6e38-4b50-a1f2-9d7c3e5b8046">
        <Shortcut
            Id="ApplicationShortcut"
            Name="The Infinity"
            Description="Spatial window workspace"
            Target="[INSTALLFOLDER]TheInfinity.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\TheInfinity" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveProgramMenuFolder" On="uninstall" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="..\dist\win-x64\**">
        <Exclude Files="..\dist\win-x64\**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
